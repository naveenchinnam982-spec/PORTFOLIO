# ===================================================================
# Naveen Chinnam Portfolio - Environment Variables
# ===================================================================
# Copy this file to .env and configure your secrets.
# NEVER commit your real .env file or credentials to Git!
# ===================================================================

# Google OAuth 2.0 Credentials (Google Cloud Console -> APIs & Services -> Credentials)
# Set your OAuth 2.0 Web Client ID here:
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Recipient Email for visitor notifications (where alerts will be sent)
NOTIFICATION_EMAIL=naveenchinnam982@gmail.com

# -------------------------------------------------------------------
# EMAIL SERVICE PROVIDER (Configure AT LEAST ONE in Netlify / .env)
# -------------------------------------------------------------------
# Option 1: Resend (Recommended - 3,000 free emails/month at https://resend.com)
# Set your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=Portfolio Visitor Alert <onboarding@resend.dev>

# Option 2: SendGrid (100 free emails/day at https://sendgrid.com)
# SENDGRID_API_KEY=SG.your_sendgrid_key_here

# Option 3: Brevo / Sendinblue (300 free emails/day at https://brevo.com)
# BREVO_API_KEY=xkeysib-your_brevo_key_here

# Session Secret (Optional - for cryptographic session signing)
SESSION_SECRET=nc_secret_entropy_key_change_in_production

# Private Admin Analytics Dashboard PIN (default: 9820)
ADMIN_PIN=9820

# Port for local development server (defaults to 8000)
PORT=8000
